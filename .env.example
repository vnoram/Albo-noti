# ─────────────────────────────────────────────────────────────────────────────
# colocolo-notifier — Variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como ".env" para desarrollo local.
# En Railway, estas variables se configuran en el panel del servicio
# (Settings → Variables) — NUNCA las subas al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Railway te la provee automáticamente al crear el servicio PostgreSQL.
# Formato: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/colocolo_notifier

# ── API-Football (https://api-sports.io) ─────────────────────────────────────
# Obtener en: https://dashboard.api-football.com/ → My Account → API Keys
API_FOOTBALL_KEY=tu_api_key_aqui

# IDs de Colo-Colo y la liga chilena
# Ejecutar: node src/scripts/find-ids.js  para obtenerlos
COLOCOLO_TEAM_ID=127    # Colo-Colo en API-Football (verificar con find-ids.js)
LEAGUE_ID=265           # Primera División Chile (verificar con find-ids.js)
SEASON=2026

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# Obtener en: developers.facebook.com → Tu App → WhatsApp → Configuración de API
#   WHATSAPP_TOKEN: Token de acceso temporal (o permanente con System User)
#   WHATSAPP_PHONE_NUMBER_ID: ID del número de teléfono de prueba
WHATSAPP_TOKEN=tu_token_whatsapp_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# Nombres EXACTOS de las plantillas como aparecen en Meta for Developers
WA_TEMPLATE_PREMATCH=colocolo_prematch
WA_TEMPLATE_REMINDER=recordatorio
WA_TEMPLATE_LINEUP=colocolo_lineup
WA_TEMPLATE_RESULT=colocolo_result

# ── Destinatario inicial ──────────────────────────────────────────────────────
# Usado solo por el script src/db/seed.js (ejecutar una vez)
INITIAL_USER_NAME=Papá
INITIAL_USER_PHONE=+56912345678

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=production
