# Copia como azure/.env.azure (esta ignorado por git) y completa los valores.

# ── Azure (solo recursos de Colo-Colo; NO usar el grupo de Geo Constanza) ──
AZ_SUBSCRIPTION_ID=          # id de tu suscripcion "Azure for Students" (az account list -o table)
AZ_LOCATION=eastus2          # debe estar permitida en tu suscripcion de estudiante (ver README)
AZ_PREFIX=colocolo           # prefijo de todos los recursos
PG_ADMIN_USER=colocoloadmin
PG_ADMIN_PASSWORD=           # contraseña fuerte nueva (min 12 caracteres)

# ── App (mismos valores que tenias en Railway) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WA_TEMPLATE_PREMATCH=prematch
WA_TEMPLATE_REMINDER=recordatorio
WA_TEMPLATE_LINEUP=colocolo_lineup
WA_TEMPLATE_RESULT=colocolo_result
COLOCOLO_TEAM_ID=2688
ESPN_LEAGUE=chi.1
# ENABLE_LINEUP_RESULT=1   # descomentar cuando existan las plantillas colocolo_lineup y colocolo_result en Meta
